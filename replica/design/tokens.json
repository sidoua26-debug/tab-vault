{
  "_about": "Design tokens for Tab Vault (Manifest V3 OneTab Rebuild). Dense list UI, light and dark themes, no cloud or social elements.",
  "color": {
    "light": {
      "bg": "#ffffff",
      "surface": "#f8f9fa",
      "border": "#dadce0",
      "border-input": "#70757a",
      "text": "#202124",
      "text-muted": "#5f6368",
      "accent": "#1a73e8",
      "on-accent": "#ffffff",
      "danger": "#d93025",
      "success": "#137333",
      "warning": "#b06000"
    },
    "dark": {
      "bg": "#202124",
      "surface": "#292a2d",
      "border": "#3c4043",
      "border-input": "#9aa0a6",
      "text": "#e8eaed",
      "text-muted": "#9aa0a6",
      "accent": "#8ab4f8",
      "on-accent": "#202124",
      "danger": "#f28b82",
      "success": "#81c995",
      "warning": "#fdd663"
    }
  },
  "pairs": [
    ["light-text", "light-bg"],
    ["light-text", "light-surface"],
    ["light-text-muted", "light-bg"],
    ["light-text-muted", "light-surface"],
    ["light-on-accent", "light-accent"],
    ["light-accent", "light-bg"],
    ["light-danger", "light-bg"],
    ["light-success", "light-bg"],
    ["light-warning", "light-bg"],
    ["light-border-input", "light-bg", "ui"],
    ["dark-text", "dark-bg"],
    ["dark-text", "dark-surface"],
    ["dark-text-muted", "dark-bg"],
    ["dark-text-muted", "dark-surface"],
    ["dark-on-accent", "dark-accent"],
    ["dark-accent", "dark-bg"],
    ["dark-danger", "dark-bg"],
    ["dark-success", "dark-bg"],
    ["dark-warning", "dark-bg"],
    ["dark-border-input", "dark-bg", "ui"]
  ],
  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace"
  },
  "type": {
    "xs": {"size": 11, "line": 14, "weight": 500},
    "sm": {"size": 12, "line": 16, "weight": 400},
    "base": {"size": 13, "line": 18, "weight": 400},
    "md": {"size": 14, "line": 20, "weight": 500},
    "lg": {"size": 16, "line": 22, "weight": 600},
    "xl": {"size": 20, "line": 26, "weight": 600}
  },
  "space": [0, 2, 4, 6, 8, 12, 16, 20, 24, 32],
  "density": {
    "row-height": "24px",
    "item-gap": "4px",
    "group-gap": "16px",
    "header-height": "40px"
  },
  "radius": {
    "none": 0,
    "sm": 3,
    "md": 6,
    "pill": 999
  },
  "shadow": {
    "none": "none",
    "toast": "0 2px 6px rgba(0,0,0,0.2)",
    "menu": "0 4px 12px rgba(0,0,0,0.15)"
  },
  "motion": {
    "fast": "100ms",
    "base": "150ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  }
}
